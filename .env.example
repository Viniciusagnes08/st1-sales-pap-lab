# ST1 Sales PAP | Homologação independente — NUNCA versionar .env com segredos.
# Web de gestão: SOMENTE no próprio PC (não pode ser exposto à rede).
PORT=4173
# API dos celulares: porta e visibilidade. Por padrão somente localhost.
PAP_MOBILE_PORT=4174
PAP_MOBILE_LAN=0
# Para API HTTPS: cert e chave PEM de teste/trusted; ambos obrigatórios.
# PAP_MOBILE_TLS_CERT=C:\\caminho\\cert.pem
# PAP_MOBILE_TLS_KEY=C:\\caminho\\key.pem

# Traccar é opcional. A versão Web continua compatível com seus recursos antigos.
TRACCAR_URL=http://127.0.0.1:8082
TRACCAR_TOKEN=
TRACCAR_EMAIL=
TRACCAR_PASSWORD=
